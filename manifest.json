{
  "manifest_version": 3,
  "name": "ModalFox",
  "version": "0.0.0",
  "description": "Vim-style modal keybindings for Firefox",
  "browser_specific_settings": {
    "gecko": {
      "id": "modalfox@cympfh.cc",
      "strict_min_version": "128.0"
    }
  },
  "permissions": ["tabs", "clipboardRead", "clipboardWrite", "sessions", "search", "management"],
  "action": {
    "default_title": "ModalFox",
    "default_popup": "popup.html",
    "default_icon": "icon.svg"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
