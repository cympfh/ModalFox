{
  "manifest_version": 3,
  "name": "ModalFox",
  "version": "0.0.0",
  "description": "Vim-style modal keybindings for Firefox",
  "browser_specific_settings": {
    "gecko": {
      "id": "modalfox@cympfh.github.io",
      "strict_min_version": "128.0"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
